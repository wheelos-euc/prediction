module_config {
  module_library: "lib/components/prediction/libprediction_component.so"
  components {
    class_name: "PredictionComponent"
    config {
      name: "prediction"
      config_file_path: "conf/prediction/prediction_conf.pb.txt"
      flag_file_path: "conf/prediction/prediction.conf"
      readers: [
        {
          channel: "/apollo/perception/obstacles"
          qos_profile: {
            depth: 1
          }
        }
      ]
    }
  }
}
